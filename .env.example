# Canvas LMS credentials (required).
# Canvas API tokens have full account access — rotate periodically and never commit.
CANVAS_API_URL=https://your-canvas-instance.instructure.com
CANVAS_API_TOKEN=

# School-specific configuration file (optional).
# Absolute path to a JSON file that defines this school's competency framework
# (and, eventually, page templates / academic calendar). Without it the MCP
# runs as a generic Canvas server and list_competencies returns a structured
# "not configured" response. With it, list_competencies surfaces the framework.
# Franklin preset ships in-repo at configs/franklin.json; other schools should
# copy configs/example.json and edit it. See README "School configuration" for
# the full schema.
# SCHOOL_CONFIG=/absolute/path/to/configs/franklin.json

# Default Canvas account id for account-scoped tools (optional).
# Used by list_account_courses and list_account_users when the caller does not
# pass account_id explicitly. Accepts a numeric id (e.g., 1) or the literal
# 'self' for the token-owner's own account. Requires account-admin scope on
# the Canvas token.
# CANVAS_ACCOUNT_ID=self

# Anonymization map storage directory (optional).
# Defaults to ~/.canvas-mcp/anon-maps/. Point at a synced folder (iCloud Drive,
# Dropbox, NAS) if you want anonymization maps to survive machine loss —
# pseudonyms in narratives/portfolios/transition-reports depend on these files
# being stable for weeks or months.
# ANON_MAP_DIR=

# execute_typescript sandbox controls (optional; defaults shown).
# Network guard ON by default — user code can reach the Canvas host parsed from
# CANVAS_API_URL but nothing else without explicit opt-out.
# TS_SANDBOX_BLOCK_OUTBOUND=true
# TS_SANDBOX_ALLOWLIST_HOSTS=

# De-anonymization opt-in (optional; defaults to OFF).
# When unset, every tool that could return real student names anonymizes
# unconditionally — even when the caller passes anonymous: false. The response
# includes a warning string explaining the override.
# Set to true ONLY when you intentionally need real names in tool output
# (e.g., reviewing comment threads with author attribution, exporting a
# real-name → pseudonym mapping from create_student_anonymization_map).
# Restart Claude Desktop after changing this value.
# CANVAS_MCP_ALLOW_DEANONYMIZE=false
